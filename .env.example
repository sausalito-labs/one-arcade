# Copy this file to .env and adjust values for your environment.

# Path to the Godot 4 binary. Falls back to `godot` on PATH, then /root/.local/bin/godot.
GODOT_BIN=/root/.local/bin/godot

# Demo server bind address. Keep 127.0.0.1 and expose via Tailscale Funnel
# (https://tailscale.com/kb/1223/funnel) so HTTPS is terminated with a valid
# cert. Your tailnet's hosted agent box usually wants 127.0.0.1.
DEMO_HOST=127.0.0.1

# Demo server port. Make sure it matches the Funnel/Serve port.
DEMO_PORT=8765

# Output directory for the HTML5 build.
BUILD_DIR=build/html5
