# Copy this file to .env and adjust values for your environment.

# Path to the Godot 4 binary. Falls back to `godot` on PATH, then /root/.local/bin/godot.
GODOT_BIN=/root/.local/bin/godot

# Demo server bind address. Use 127.0.0.1 for localhost-only, 0.0.0.0 to listen
# on all interfaces (needed for VPS/Tailscale access).
DEMO_HOST=0.0.0.0

# Demo server port. Make sure your firewall allows it.
DEMO_PORT=8765

# Serve over HTTPS. Required for Godot Web features when accessed over the
# public internet (non-localhost). Self-signed cert is generated on first run.
DEMO_HTTPS=true

# Paths for the self-signed certificate.
DEMO_CERT=build/certs/demo.crt
DEMO_KEY=build/certs/demo.key

# Output directory for the HTML5 build.
BUILD_DIR=build/html5
